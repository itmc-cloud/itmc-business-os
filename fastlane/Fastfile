default_platform(:android)

# Absolute paths anchored to this Fastfile's own location, rather than
# relative paths that depend on assuming what Fastlane's working directory
# is at lane-execution time (that assumption broke in CI — see git history).
PROJECT_ROOT = File.expand_path("..", __dir__)
AAB_PATH = File.join(PROJECT_ROOT, "build/app/outputs/bundle/release/app-release.aab")

platform :android do
  desc "Build the release .aab (requires android/key.properties — see docs/PUBLISHING.md)"
  lane :build_release do
    Dir.chdir(PROJECT_ROOT) do
      sh("flutter", "build", "appbundle", "--release")
    end
  end

  desc "Capture Play Store screenshots automatically from a running emulator/device " \
       "(no manual screenshotting — see scripts/capture_screenshots.sh). Run this " \
       "locally whenever the UI changes meaningfully, then commit the updated images."
  lane :screenshots do
    Dir.chdir(PROJECT_ROOT) do
      sh("bash", "scripts/capture_screenshots.sh")
    end
  end

  desc "Build and upload to the Internal testing track (binary only — fast iteration, " \
       "no listing changes)"
  lane :deploy_internal do
    build_release
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the build already sitting on Internal testing straight to " \
       "Production — no rebuild, same binary/version code that's already been " \
       "tested. This is the normal path: test on internal, then promote that " \
       "exact build. Pass rollout: '0.1' etc. for a staged rollout (default 100%)."
  lane :promote_production do |options|
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      rollout: (options[:rollout] || "1.0"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Build and upload a FRESH binary directly to Production — binary, store " \
       "listing text, icon/feature graphic, and screenshots, all pushed from " \
       "fastlane/metadata/ with zero manual Play Console form-filling. Only use " \
       "this if you deliberately want production to differ from what's on " \
       "internal (it needs pubspec.yaml's build number bumped first, since Play " \
       "rejects re-uploading a version code that already exists on any track). " \
       "Normally you want promote_production instead. Pass rollout: '0.1' etc. " \
       "for a staged rollout (default 100%)."
  lane :deploy_production do |options|
    build_release
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      rollout: (options[:rollout] || "1.0"),
    )
  end
end
